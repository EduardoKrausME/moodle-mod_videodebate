{{!
    @template mod_videodebate/report

    Example context (json):
    {
        "name": "Climate policy debate",
        "hasrows": true,
        "rows": [
            {
                "fullname": "Student Example",
                "position": "Agree",
                "arguments": 1,
                "replies": 2,
                "participation": 3,
                "percent": 80,
                "grade": "90.00"
            }
        ]
    }
}}
<div class="videodebate-report">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2>{{#str}}report, videodebate{{/str}} — {{name}}</h2>
        <a class="btn btn-outline-secondary" href="{{{backurl}}}">{{#str}}backtodebate, videodebate{{/str}}</a>
    </div>
    {{{groupselector}}}
    {{^hasrows}}
        <div class="alert alert-info">{{#str}}nostudents, videodebate{{/str}}</div>
    {{/hasrows}}
    {{#hasrows}}
        <div class="table-responsive">
            <table class="table table-striped align-middle">
                <thead>
                <tr>
                    <th>{{#str}}student, videodebate{{/str}}</th>
                    <th>{{#str}}position, videodebate{{/str}}</th>
                    <th>{{#str}}arguments, videodebate{{/str}}</th>
                    <th>{{#str}}evidence, videodebate{{/str}}</th>
                    <th>{{#str}}replies, videodebate{{/str}}</th>
                    <th>{{#str}}participation, videodebate{{/str}}</th>
                    <th>{{#str}}videoprogress, videodebate{{/str}}</th>
                    <th>{{#str}}lastaccess, videodebate{{/str}}</th>
                    <th>{{#str}}grade, videodebate{{/str}}</th>
                    <th></th>
                </tr>
                </thead>
                <tbody>
                {{#rows}}
                    <tr>
                        <td><div class="d-flex gap-2 align-items-center">{{{userpicture}}}<span>{{fullname}}</span></div></td>
                        <td>{{position}}</td>
                        <td>{{arguments}}</td>
                        <td>
                            {{#hasevidence}}{{#evidenceitems}}
                                <div><strong>{{timecode}}</strong>{{#haslabel}} · {{label}}{{/haslabel}}</div>
                            {{/evidenceitems}}{{/hasevidence}}
                            {{^hasevidence}}—{{/hasevidence}}
                        </td>
                        <td>{{replies}}</td>
                        <td>{{participation}}</td>
                        <td>{{percent}}%</td>
                        <td>{{lastaccess}}</td>
                        <td>{{grade}}</td>
                        <td>
                            {{#cangrade}}
                                <a class="btn btn-sm btn-primary" href="{{{gradeurl}}}">{{#str}}grade, videodebate{{/str}}</a>
                            {{/cangrade}}
                        </td>
                    </tr>
                {{/rows}}
                </tbody>
            </table>
        </div>
    {{/hasrows}}
</div>
