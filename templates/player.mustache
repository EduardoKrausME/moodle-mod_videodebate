{{!
    @template mod_videodebate/player

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="videodebate-player-wrap" data-region="player-wrap">
    {{#player}}
        {{#source}}
            {{#ishtml5}}{{/ishtml5}}
        {{/source}}
        {{#url}}
            {{^videoid}}
                <video id="videodebate-player" class="videodebate-player" controls preload="metadata" playsinline>
                    <source src="{{{url}}}">
                </video>
            {{/videoid}}
        {{/url}}
        {{#videoid}}
            {{#youtube}}
                <div id="videodebate-player" class="videodebate-embed" data-videoid="{{videoid}}"
                     data-source="youtube"></div>
            {{/youtube}}
            {{#vimeo}}
                <iframe id="videodebate-player" class="videodebate-embed" data-source="vimeo"
                        src="https://player.vimeo.com/video/{{videoid}}?api=1&dnt=1"
                        allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>
            {{/vimeo}}
        {{/videoid}}
    {{/player}}
</div>
