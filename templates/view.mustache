{{!
    @template mod_videodebate/view

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="videodebate" data-region="videodebate" data-config="{{configjson}}">
    <div class="d-flex justify-content-between align-items-start gap-3 mb-3">
        <div>
            <h2>{{name}}</h2>
            {{#hasintro}}
                <div class="mb-3">{{{intro}}}</div>{{/hasintro}}
        </div>
        {{#canviewreport}}<a class="btn btn-outline-secondary" href="{{{reporturl}}}">{{#str}}
            report, videodebate{{/str}}</a>{{/canviewreport}}
    </div>

    <div class="card mb-4">
        <div class="card-body">
            <h3 class="h5">{{#str}}debatequestion, videodebate{{/str}}</h3>
            <div class="lead">{{{question}}}</div>
        </div>
    </div>

    <div class="videodebate-player-card card mb-3">
        <div class="card-body">
            {{#player}}
                {{#videoid}}
                    {{#youtube}}
                        <div id="videodebate-player" class="videodebate-embed" data-videoid="{{videoid}}"
                             data-source="youtube"></div>{{/youtube}}
                    {{#vimeo}}
                        <iframe id="videodebate-player" class="videodebate-embed" data-source="vimeo"
                                src="https://player.vimeo.com/video/{{videoid}}?api=1&dnt=1"
                                allow="autoplay; fullscreen; picture-in-picture" allowfullscreen></iframe>{{/vimeo}}
                {{/videoid}}
                {{^videoid}}
                    <video id="videodebate-player" class="videodebate-player" controls preload="metadata" playsinline>
                        <source src="{{{url}}}">
                    </video>
                {{/videoid}}
            {{/player}}
            <div class="mt-3">
                <div class="d-flex justify-content-between"><span>{{#str}}
                    videoprogress, videodebate{{/str}}</span><strong data-region="percent">{{percent}}%</strong></div>
                <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100"
                     aria-valuenow="{{percent}}">
                    <div class="progress-bar" data-region="progress-bar" style="width: {{percent}}%"></div>
                </div>
                <small class="text-muted">{{#str}}requiredpercent, videodebate, {{requiredpercent}}{{/str}}</small>
                <div class="alert alert-warning d-none mt-2" data-region="tracking-message"></div>
            </div>
            <div class="videodebate-timeline mt-3" data-region="evidence-timeline"
                 aria-label="{{#str}}evidencetimeline, videodebate{{/str}}"></div>
        </div>
    </div>

    {{#initialposted}}
        <div class="alert alert-success">{{#str}}positionpublished, videodebate{{/str}}
            <strong>{{initialposition}}</strong></div>
    {{/initialposted}}
    {{#lockedothers}}
        <div class="alert alert-info">{{#str}}publishbeforeview, videodebate{{/str}}</div>
    {{/lockedothers}}

    {{#showothers}}
        <section class="videodebate-thread mt-4" aria-labelledby="videodebate-thread-heading">
            <h3 id="videodebate-thread-heading">{{#str}}debate, videodebate{{/str}}</h3>
            {{^hasposts}}
                <div class="alert alert-light border">{{#str}}noposts, videodebate{{/str}}</div>{{/hasposts}}
            {{#posts}}
                <article class="card mb-3 videodebate-post" data-postid="{{id}}">
                    <div class="card-body">
                        <div class="d-flex gap-2 align-items-center mb-2">{{{userpicture}}}
                            <div><strong>{{fullname}}</strong>{{#position}}
                                <div><span class="badge bg-secondary">{{position}}</span></div>{{/position}}</div>
                        </div>
                        <div class="videodebate-message mb-3">{{{message}}}</div>
                        {{#evidence}}
                            <button type="button" class="btn btn-sm btn-outline-primary me-1 mb-1"
                                    data-action="seek-evidence" data-time="{{start}}">
                                {{timecode}}{{#hasend}}–{{endtimecode}}{{/hasend}}{{#label}} · {{label}}{{/label}}
                            </button>
                        {{/evidence}}
                        <div class="small text-muted mt-2">{{date}}</div>
                        {{#canreply}}
                            <a class="btn btn-sm btn-link px-0" href="{{{replyurl}}}#videodebate-post-form">{{#str}}
                                reply, videodebate{{/str}}</a>{{/canreply}}
                    </div>
                    {{#hasreplies}}
                        <div class="card-footer bg-transparent">
                            {{#replies}}
                                <div class="videodebate-reply border-start ps-3 py-2">
                                    <div class="d-flex gap-2 align-items-center mb-1">{{{userpicture}}}
                                        <strong>{{fullname}}</strong></div>
                                    <div>{{{message}}}</div>
                                    {{#evidence}}
                                        <button type="button" class="btn btn-sm btn-outline-primary me-1 mt-1"
                                                data-action="seek-evidence"
                                                data-time="{{start}}">{{timecode}}{{#hasend}}
                                            –{{endtimecode}}{{/hasend}}</button>{{/evidence}}
                                    <div class="small text-muted mt-1">{{date}}</div>
                                </div>
                            {{/replies}}
                        </div>
                    {{/hasreplies}}
                </article>
            {{/posts}}
        </section>
    {{/showothers}}
</div>
